---
// The primary building blocks (docs/briefs/harness-engineering.md, *Graph*):
// six hand-placed nodes and their edges, drawn like the landing topic graph:
// SVG rings over centre-to-centre edges, labels below. A wide and a phone
// layout are swapped by CSS. The graph is hidden from assistive tech; the
// list below it is the text equivalent. src/scripts/harness-graph.ts
// animates the entrance and the rest state.
import {
  centre,
  edgeD,
  edges,
  edgeSentence,
  parts,
  phone,
  wide,
} from '../lib/harness-graph';

const layouts = { wide, phone };
const colours = [
  'neutral',
  'context',
  'constraints',
  'capabilities',
  'feedback',
];
// On a phone the four primitives sit side by side, so their labels wrap.
const lines = (name: string, p: (typeof parts)[number]) =>
  name === 'phone' && p.colour !== 'neutral' ? p.label.split(' ') : [p.label];
---

<div class="harness-graph" data-harness-graph>
  <div class="box" aria-hidden="true">
    {Object.entries(layouts).map(([name, layout]) => (
      <svg
        class={`graph graph-${name}`}
        viewBox={`0 0 ${layout.width} ${layout.height}`}
        data-r={layout.r}
      >
        <defs>
          {colours.map((c) => (
            <marker
              id={`arrow-${name}-${c}`}
              viewBox="0 0 10 10"
              refX="9"
              refY="5"
              markerWidth="6"
              markerHeight="6"
              orient="auto"
            >
              <path d="M0 1 L9 5 L0 9 z" class={`fill-${c}`} />
            </marker>
          ))}
        </defs>
        <g class="edges">
          {edges.map((e) => (
            <path
              class={`edge stroke-${e.colour}`}
              data-edge={`${e.from}-${e.to}`}
              data-from={e.from}
              data-to={e.to}
              data-directed={e.directed ? '' : undefined}
              d={edgeD(
                centre(layout, e.from),
                centre(layout, e.to),
                layout.r,
                e.directed,
              )}
              pathLength="1"
              marker-end={
                e.directed ? `url(#arrow-${name}-${e.colour})` : undefined
              }
            />
          ))}
        </g>
        {parts.map((p) => {
          const c = centre(layout, p.id);
          return (
            <g
              class={`node node-${p.colour}`}
              data-node={p.id}
              data-x={c.x}
              data-y={c.y}
              transform={`translate(${c.x} ${c.y})`}
            >
              <g class="body">
                <circle class="ring" r={layout.r} />
                <circle class="core" r={layout.r * 0.23} />
                <text class="label" y={layout.r + 18}>
                  {lines(name, p).map((l, i) => (
                    <tspan x="0" dy={i ? 14 : 0}>
                      {l}{' '}
                    </tspan>
                  ))}
                </text>
              </g>
            </g>
          );
        })}
      </svg>
    ))}
  </div>

  <ul class="sr-only" data-graph-text>
    {parts.map((p) => (
      <li>
        Part {p.numeral}, {p.label}: {p.summary}
      </li>
    ))}
    {edges.map((e) => (
      <li>{edgeSentence(e)}</li>
    ))}
  </ul>
</div>

<script>
  import { mountHarnessGraph } from '../scripts/harness-graph';
  document
    .querySelectorAll<HTMLElement>('[data-harness-graph]')
    .forEach(mountHarnessGraph);
</script>

<style>
  .box {
    margin-inline: auto;
    width: 100%;
    max-width: 1000px;
  }
  .graph {
    display: block;
    width: 100%;
    height: auto;
    fill: none;
  }
  .graph-phone {
    display: none;
  }
  .edge {
    stroke-width: 2;
  }
  /* Opaque, so the edges stop at the ring instead of meeting behind the dot. */
  .ring {
    fill: var(--color-surface);
    stroke: var(--node-colour, var(--color-border-strong));
    stroke-width: 2;
  }
  .core {
    fill: var(--node-colour, var(--color-border-strong));
  }
  .label {
    font-size: 13px;
    fill: var(--color-text-2);
    text-anchor: middle;
    /* A halo keeps the text readable where an edge runs behind it. */
    stroke: var(--color-bg-alt);
    stroke-width: 4px;
    stroke-linejoin: round;
    paint-order: stroke;
  }
  .node-context {
    --node-colour: var(--color-context);
  }
  .node-constraints {
    --node-colour: var(--color-constraints);
  }
  .node-capabilities {
    --node-colour: var(--color-capabilities);
  }
  .node-feedback {
    --node-colour: var(--color-feedback);
  }
  .stroke-neutral {
    stroke: var(--color-border-strong);
  }
  .stroke-context {
    stroke: var(--color-context);
  }
  .stroke-constraints {
    stroke: var(--color-constraints);
  }
  .stroke-capabilities {
    stroke: var(--color-capabilities);
  }
  .stroke-feedback {
    stroke: var(--color-feedback);
  }
  .fill-neutral {
    fill: var(--color-border-strong);
  }
  .fill-context {
    fill: var(--color-context);
  }
  .fill-constraints {
    fill: var(--color-constraints);
  }
  .fill-capabilities {
    fill: var(--color-capabilities);
  }
  .fill-feedback {
    fill: var(--color-feedback);
  }

  @media (max-width: 1023px) {
    .box {
      max-width: 420px;
    }
    .graph-wide {
      display: none;
    }
    .graph-phone {
      display: block;
    }
    .label {
      font-size: 12px;
    }
  }

  /* Entrance: hidden only once the script has taken over, so no-JS and
     reduced-motion visitors see the settled graph. */
  [data-harness-graph][data-anim='ready'] .body {
    opacity: 0;
  }
  [data-harness-graph][data-anim='ready'] .edge {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }
  [data-harness-graph][data-anim='ready'] marker {
    opacity: 0;
  }
</style>
