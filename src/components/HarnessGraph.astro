---
// The primary building blocks (docs/briefs/harness-engineering.md, *Graph*):
// six hand-placed nodes and their edges, drawn like the landing topic graph:
// SVG rings over centre-to-centre edges, labels below. A wide and a phone
// layout are swapped by CSS. The graph is hidden from assistive tech; the
// list below it is the text equivalent. src/scripts/harness-graph.ts
// animates the entrance and the rest state.
import {
  centre,
  edgeD,
  edges,
  edgeSentence,
  hub,
  labelAbove,
  parts,
  phone,
  wide,
} from '../lib/harness-graph';

const layouts = { wide, phone };
// On a phone the nodes are close, so labels wrap word by word.
const lines = (name: string, label: string) =>
  name === 'phone' ? label.split(' ') : [label];
// First baseline: below the ring, or above it with room for every line.
const labelY = (id: string, r: number, n: number) =>
  labelAbove.has(id) ? -(r + 10) - 14 * (n - 1) : r + 18;
---

<div class="harness-graph" data-harness-graph>
  <div class="box" aria-hidden="true">
    {Object.entries(layouts).map(([name, layout]) => (
      <svg
        class={`graph graph-${name}`}
        viewBox={`0 0 ${layout.width} ${layout.height}`}
        data-hub-r={layout.hubR}
      >
        <g class="edges">
          {edges.map((e) => (
            <path
              class="edge"
              data-edge={`${e.from}-${e.to}`}
              data-from={e.from}
              data-to={e.to}
              d={edgeD(centre(layout, e.from), centre(layout, e.to))}
              pathLength="1"
            />
          ))}
        </g>
        {/* Temporary: the heuristics move to their own page later. The anchor
            is mouse and touch only; the graph is hidden from assistive tech,
            so the text list carries a real link. */}
        <a href="#heuristics" tabindex="-1">
          <g
            class="node hub"
            data-node={hub.id}
            data-x={centre(layout, hub.id).x}
            data-y={centre(layout, hub.id).y}
            transform={`translate(${centre(layout, hub.id).x} ${centre(layout, hub.id).y})`}
          >
            <g class="body">
              <g class="focus">
                <circle class="ring" r={layout.hubR} />
                <text class="hub-label" dy="0.35em">
                  {hub.label}
                </text>
              </g>
            </g>
          </g>
        </a>
        {parts.map((p) => {
          const c = centre(layout, p.id);
          const ls = lines(name, p.label);
          return (
            <g
              class="node"
              data-node={p.id}
              data-x={c.x}
              data-y={c.y}
              transform={`translate(${c.x} ${c.y})`}
            >
              <g class="body">
                <g class="focus">
                  <circle class="under" r={layout.r} />
                  <circle class="ring" r={layout.r} />
                  <circle class="core" r={layout.r * 0.23} />
                  <text class="label" y={labelY(p.id, layout.r, ls.length)}>
                    {ls.map((l, i) => (
                      <tspan x="0" dy={i ? 14 : 0}>
                        {l}{' '}
                      </tspan>
                    ))}
                  </text>
                </g>
              </g>
            </g>
          );
        })}
      </svg>
    ))}
  </div>

  <ul class="sr-only" data-graph-text>
    {parts.map((p) => (
      <li>
        Part {p.numeral}, {p.label}: {p.summary}
      </li>
    ))}
    {edges.map((e) => (
      <li>{edgeSentence(e)}</li>
    ))}
    <li>
      <a href="#heuristics">Jump to the twelve heuristics</a>
    </li>
  </ul>
</div>

<script>
  import { mountHarnessGraph } from '../scripts/harness-graph';
  document
    .querySelectorAll<HTMLElement>('[data-harness-graph]')
    .forEach(mountHarnessGraph);
</script>

<style>
  .box {
    margin-inline: auto;
    width: 100%;
    max-width: 1000px;
  }
  .graph {
    display: block;
    width: 100%;
    height: auto;
    fill: none;
  }
  .graph-phone {
    display: none;
  }
  .edge {
    stroke: var(--color-border-strong);
    stroke-width: 1.5;
    transition:
      opacity 0.25s,
      stroke 0.25s;
  }
  /* Hover (docs/design-system.md#motion): the rest dims, the node's own
     edges light up, and the node grows. */
  .edge.hl {
    stroke: var(--color-accent-strong);
  }
  .edge.dim {
    opacity: 0.2;
  }
  .node {
    transition: opacity 0.25s;
  }
  .node {
    cursor: pointer;
  }
  .hub:hover .ring {
    stroke: var(--color-accent-strong);
  }
  .node.dim {
    opacity: 0.3;
  }
  .focus {
    transition: transform 0.25s;
  }
  .node.on .focus {
    transform: scale(1.15);
  }
  /* A part is "live", as on the landing graph: tinted ring, glow, dot. The
     opaque disc under the tint stops the edges at the ring. */
  .under {
    fill: var(--color-bg-alt);
  }
  .ring {
    fill: var(--color-accent-tint);
    stroke: var(--color-accent-strong);
    stroke-width: 2;
    filter: drop-shadow(0 0 10px var(--color-accent));
  }
  .core {
    fill: var(--color-accent-strong);
  }
  .hub .ring {
    /* Opaque, so the edges stop at the ring instead of meeting behind "Heuristics". */
    fill: var(--color-bg-alt);
    stroke: var(--color-border-strong);
    filter: none;
  }
  .hub-label {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.02em;
    fill: var(--color-text-2);
    text-anchor: middle;
  }
  .graph :global(.spark) {
    fill: none;
    stroke: var(--color-accent-strong);
    stroke-width: 1.6;
    stroke-linejoin: round;
    filter: drop-shadow(0 0 4px var(--color-accent))
      drop-shadow(0 0 10px var(--color-accent));
    pointer-events: none;
  }
  .label {
    font-size: 13px;
    fill: var(--color-text);
    font-weight: 600;
    text-anchor: middle;
    /* A halo keeps the text readable where an edge runs behind it. */
    stroke: var(--color-bg-alt);
    stroke-width: 4px;
    stroke-linejoin: round;
    paint-order: stroke;
  }
  @media (max-width: 1023px) {
    .box {
      max-width: 420px;
    }
    .graph-wide {
      display: none;
    }
    .graph-phone {
      display: block;
    }
    .label {
      font-size: 12px;
    }
    .hub-label {
      font-size: 11px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .edge,
    .node,
    .focus {
      transition: none;
    }
  }

  /* Entrance: hidden only once the script has taken over, so no-JS and
     reduced-motion visitors see the settled graph. */
  [data-harness-graph][data-anim='ready'] .body {
    opacity: 0;
  }
  [data-harness-graph][data-anim='ready'] .edge {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }
</style>
