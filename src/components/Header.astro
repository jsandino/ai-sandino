---
// Sticky header: the wordmark (links home) and a GitHub link
// (docs/briefs/shell.md, Decided #1). The progressive blur is the
// design system's "Sticky header" effect.
const REPO_URL = 'https://github.com/jsandino/ai-sandino';
---

<header class="site-header sticky top-0 z-10">
  <div class="mx-auto flex h-[70px] max-w-[1100px] items-center justify-between px-6">
    <a href="/" class="text-text font-mono text-[13px] lowercase no-underline">
      <span class="text-accent-text">ai</span>.sandino.ca
    </a>
    <a
      href={REPO_URL}
      aria-label="Source on GitHub"
      class="text-text-2 hover:text-accent-text p-2 transition-colors"
    >
      <svg
        viewBox="0 0 16 16"
        width="20"
        height="20"
        fill="currentColor"
        aria-hidden="true"
      >
        <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"></path>
      </svg>
    </a>
  </div>
</header>

<style>
  /* Progressive blur: the blur layer extends below the header and fades
     out through a gradient mask. The mask uses only alpha, so the opaque
     bg token serves as its solid stop. */
  .site-header::before {
    content: '';
    position: absolute;
    inset: 0 0 -24px;
    z-index: -1;
    backdrop-filter: blur(10px);
    background: linear-gradient(
      var(--color-bg) 0%,
      color-mix(in srgb, var(--color-bg) 70%, transparent) 60%,
      transparent 100%
    );
    mask-image: linear-gradient(var(--color-bg) 55%, transparent);
  }
</style>
