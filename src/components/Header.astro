---
// Sticky header: the wordmark (links home), the theme toggle
// (docs/decisions/0015) and a GitHub link (docs/briefs/shell.md,
// Decided #1). The progressive blur is the design system's "Sticky
// header" effect.
const REPO_URL =
  'https://github.com/jsandino/ai-sandino#practical-ai-engineering';
---

<header class="site-header sticky top-0 z-10">
  <div class="mx-auto flex h-[70px] max-w-[1100px] items-center justify-between px-6">
    <a href="/" class="text-text font-mono text-[13px] lowercase no-underline">
      <span class="text-accent-text">ai</span>.sandino.ca
    </a>
    <div class="flex items-center gap-1">
      <button
        type="button"
        class="theme-toggle text-text-2 hover:text-accent-text cursor-pointer p-2 transition-colors"
        aria-label="Switch to light theme"
      >
        <svg
          class="icon-sun"
          viewBox="0 0 24 24"
          width="20"
          height="20"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
        </svg>
        <svg
          class="icon-moon"
          viewBox="0 0 24 24"
          width="20"
          height="20"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>
      <a
        href={REPO_URL}
        aria-label="Source on GitHub"
        class="text-text-2 hover:text-accent-text p-2 transition-colors"
      >
        <svg
          viewBox="0 0 16 16"
          width="20"
          height="20"
          fill="currentColor"
          aria-hidden="true"
        >
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"></path>
        </svg>
      </a>
    </div>
  </div>
</header>

<script>
  // Flip the theme and favicon, remember the choice, and keep the label
  // naming the action.
  const root = document.documentElement;
  const button = document.querySelector<HTMLButtonElement>('.theme-toggle')!;
  const label = () =>
    button.setAttribute(
      'aria-label',
      root.dataset.theme === 'light'
        ? 'Switch to dark theme'
        : 'Switch to light theme',
    );
  label();
  button.addEventListener('click', () => {
    const next = root.dataset.theme === 'light' ? 'dark' : 'light';
    root.dataset.theme = next;
    document.querySelector<HTMLLinkElement>('link[rel="icon"]')!.href =
      `/favicon-${next}.svg`;
    try {
      localStorage.setItem('theme', next);
    } catch {
      // Blocked storage: the switch still applies to this page.
    }
    label();
  });
</script>

<style>
  /* Show the theme the button switches to. */
  :global([data-theme='light']) .icon-sun,
  :global([data-theme='dark']) .icon-moon {
    display: none;
  }

  /* Progressive blur: the blur layer extends below the header and fades
     out through a gradient mask. The mask uses only alpha, so the opaque
     bg token serves as its solid stop. */
  .site-header::before {
    content: '';
    position: absolute;
    inset: 0 0 -24px;
    z-index: -1;
    backdrop-filter: blur(10px);
    background: linear-gradient(
      var(--color-bg) 0%,
      color-mix(in srgb, var(--color-bg) 70%, transparent) 60%,
      transparent 100%
    );
    mask-image: linear-gradient(var(--color-bg) 55%, transparent);
  }
</style>
