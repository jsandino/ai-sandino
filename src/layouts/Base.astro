---
// The shared shell every page uses: metadata, theme, header, footer
// (docs/briefs/shell.md). Pages put their content in the default slot, and
// may put a decorative layer behind it in the "backdrop" slot (the landing
// page's grid and beams).
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import '../styles/global.css';

interface Props {
  /** Page title; " — ai.sandino.ca" is appended. */
  title: string;
  description: string;
  /** Social preview image path; must be 1200×630. */
  image?: string;
}

const SITE_NAME = 'ai.sandino.ca';
const { title, description, image = '/og.png' } = Astro.props;
const fullTitle = `${title} — ${SITE_NAME}`;
// `site` comes from astro.config.mjs. The unit tests' Container API
// renders without it, so fall back to the request URL there.
const origin = Astro.site ?? Astro.url;
// build.format 'file' gives Astro.url a .html suffix ("/index.html",
// "/404.html"); the served URL has none (docs/decisions/0014).
const path = Astro.url.pathname
  .replace(/\/index\.html$/, '/')
  .replace(/\.html$/, '');
const canonical = new URL(path, origin).href;
const imageUrl = new URL(image, origin).href;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon-dark.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script is:inline>
      // Dark by default; restore a saved light choice, and its favicon,
      // before first paint so it doesn't flash (docs/decisions/0015).
      // Runs after the icon link so it can find it. Storage can be blocked.
      try {
        if (localStorage.getItem('theme') === 'light') {
          document.documentElement.dataset.theme = 'light';
          document.querySelector('link[rel="icon"]').href =
            '/favicon-light.svg';
        }
      } catch {
        // Blocked storage: stay dark.
      }
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Practical AI engineering — ai.sandino.ca"
    />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body class="flex min-h-screen flex-col">
    <Header />
    <div class="relative flex flex-1 flex-col">
      <slot name="backdrop" />
      <main class="relative mx-auto w-full max-w-[1100px] flex-1 px-6">
        <slot />
      </main>
    </div>
    <Footer />
  </body>
</html>
