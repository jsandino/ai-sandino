---
// 404: text and illustration from docs/briefs/shell.md, Decided #5.
import Base from '../layouts/Base.astro';
---

<Base
  title="Page not found"
  description="This page doesn't exist on ai.sandino.ca."
>
  <div class="flex flex-col items-start gap-6 py-24">
    <img src="/404-escaped-node.svg" alt="" width="320" height="220" />
    <h1 class="text-[clamp(32px,4.5vw,44px)]">Page not found</h1>
    <p class="text-text-2 max-w-[62ch] text-lg">
      This page escaped the harness. We're writing a check so it never happens
      again.
    </p>
    <a
      href="/"
      class="text-accent-text font-mono text-xs tracking-widest uppercase hover:underline"
    >
      Back to the home page
    </a>
  </div>
</Base>
