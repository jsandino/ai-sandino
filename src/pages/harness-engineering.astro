---
// The Harness Engineering topic page (docs/briefs/harness-engineering.md):
// hero, the graph, the PDF, the repo.
import Backdrop from '../components/Backdrop.astro';
import HarnessGraph from '../components/HarnessGraph.astro';
import { topics } from '../data/topics';
import Base from '../layouts/Base.astro';

const topic = topics.find((t) => t.slug === 'harness-engineering')!;
const band =
  'shadow-[0_0_0_100vmax_var(--color-bg-alt)] [clip-path:inset(0_-100vmax)] bg-bg-alt';
const title = 'mb-4 text-[clamp(32px,4.5vw,44px)]';
---

<Base title={topic.title} description={topic.blurb}>
  <Backdrop slot="backdrop" />
  <section id="hero" class="pt-24 pb-16" aria-labelledby="hero-title">
    <h1 id="hero-title" class="mb-[18px] text-[clamp(40px,7vw,72px)]">
      {topic.title}
    </h1>
    <p class="text-text-2 max-w-[640px] text-[clamp(17px,2vw,20px)]">
      {topic.blurb}
    </p>
  </section>

  <section id="graph" class="py-16" aria-labelledby="graph-title">
    <h2 id="graph-title" class={`${title} mb-10`}>
      Primary Building Blocks
    </h2>
    <HarnessGraph />
  </section>

  <section id="pdf" class={`${band} py-16`} aria-labelledby="pdf-title">
    <h2 id="pdf-title" class="sr-only">
      The Guide as a PDF
    </h2>
    <a
      href={topic.pdf}
      download
      class="bg-accent text-accent-ink inline-block rounded-[4px] px-5 py-3 font-mono text-xs tracking-[0.1em] uppercase"
    >
      Download the guide (PDF)
    </a>
    <p class="text-text-2 mt-3 text-[15px]">
      A Practical Guide to Harness Engineering
    </p>
  </section>

  <section id="github" class="py-16" aria-labelledby="github-title">
    <h2 id="github-title" class="sr-only">
      The Companion Project
    </h2>
    <p class="text-text-2 mb-3">This site was built using these principles.</p>
    <a
      href={topic.github}
      class="text-accent-text font-mono text-xs tracking-[0.1em] uppercase underline-offset-4 hover:underline"
    >
      Browse the source on GitHub
    </a>
  </section>
</Base>
