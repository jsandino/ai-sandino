---
// The landing page (docs/briefs/landing.md): the hero, then the topic
// graph and its card on a feathered panel, over the grid and beams.
import Backdrop from '../components/Backdrop.astro';
import TopicGraph from '../components/TopicGraph.astro';
import Base from '../layouts/Base.astro';
---

<Base
  title="Practical AI engineering"
  description="Practical AI engineering, explained through interactive pages, companion PDF guides and working code."
>
  <Backdrop slot="backdrop" />
  <section class="pt-24 pb-14">
    <h1 class="mb-[18px] text-[clamp(48px,8vw,84px)]">
      Practical AI <span class="text-accent-strong">engineering</span>
    </h1>
    <p class="text-text-2 text-[clamp(17px,2vw,20px)]">
      Learn how AI systems actually get built — from first principles to
      production.
    </p>
  </section>
  <TopicGraph />
</Base>
